#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp ESC   &kp B  &kp M     &kp L
                &kp LALT  &kp Z  &kp X     &kp ENTER
                &kp N1    &kp N2 &kp N3    &kp N4  &kp N5
                &kp TAB   &kp Q  &kp W     &kp E   &kp N6
                &kp LSHFT &kp A  &kp S     &kp D   &kp R
                &kp LCTRL &mo 1  &kp SPACE         &kp F
                                                   &kp G
            >;
        };

        fn {
            bindings = <
                &bt BT_CLR &kp O  &trans  &trans
                &trans     &kp C  &kp P   &trans
                &kp F1     &kp F2 &kp F3  &kp F4  &kp F5
                &trans &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans
                &trans &rgb_ug RGB_EFF &trans &trans &trans
                &trans     &trans &trans          &trans
                                                  &trans
            >;
        };
    };
};